DJANGO_SECRET_KEY=replace-with-generated-secret
POSTGRES_PASSWORD=replace-with-generated-password
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-random-password-at-least-16-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_PORT=8000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Disable only on development copies sharing the production bot.
TELEGRAM_POLLING_ENABLED=true

# Optional AI product selection. Set on the server; never commit the actual key.
# OPENAI_MODEL must name a model available to your API project with Structured Outputs.
OPENAI_API_KEY=
# Server-only p1 catalog access. Never expose this token to the browser or AI.
P1_API_TOKEN=
OPENAI_MODEL=gpt-6-luna
